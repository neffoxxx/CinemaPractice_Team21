@using Infrastructure.Entities
@model IEnumerable<Ticket>
<div class="container">
    <h2>My Tickets</h2>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-ticket-alt"></i>
            <h3>Квитків поки немає</h3>
            <p>У вас ще немає квитків. Перегляньте наші останні фільми та забронюйте свій наступний кіносеанс!</p>
            <a href="@Url.Action("Index", "Film")" class="btn btn-primary">
                <i class="fas fa-film me-2"></i>Переглянути фільми
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Movie</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Hall</th>
                        <th>Row</th>
                        <th>Seat</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in Model)
                    {
                        <tr>
                            <td>@(ticket.Session?.Movie?.Title ?? "N/A")</td>
                            <td>@(ticket.Session?.StartTime.ToShortDateString() ?? "N/A")</td>
                            <td>@(ticket.Session?.StartTime.ToShortTimeString() ?? "N/A")</td>
                            <td>@(ticket.Session?.Hall?.Name ?? "N/A")</td>
                            <td>@ticket.RowNumber</td>
                            <td>@ticket.SeatNumber</td>
                            <td>@ticket.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>