@model Infrastructure.Entities.Movie
@using System.Globalization

@{
    string GetEmbedUrl(string url)
    {
        if (string.IsNullOrEmpty(url)) return "";

        // Handle youtube.com/watch?v= format
        if (url.Contains("youtube.com/watch?v="))
        {
            var videoId = url.Split("watch?v=").Last().Split('&').First();
            return $"https://www.youtube.com/embed/{videoId}";
        }
        // Handle youtu.be/ format
        else if (url.Contains("youtu.be/"))
        {
            var videoId = url.Split("youtu.be/").Last().Split('?').First();
            return $"https://www.youtube.com/embed/{videoId}";
        }

        return url;
    }
}

<div class="container mt-4">
    <div class="row">

        <div class="movie-details-container">
            <div class="movie-header">
                <div class="movie-poster">
                    @if (!string.IsNullOrEmpty(Model.PosterUrl))
                    {
                        <img src="@Model.PosterUrl" alt="@Model.Title" />
                    }
                </div>

                <div class="movie-info">
                    <h1 class="movie-title">@Model.Title</h1>

                    <div class="movie-metadata">
                        <div class="metadata-item">
                            <span class="metadata-label">Duration</span>
                            <span class="metadata-value">@Model.DurationMinutes minutes</span>
                        </div>

                        <div class="metadata-item">
                            <span class="metadata-label">Release Date</span>
                            <span class="metadata-value">@Model.ReleaseDate.ToString("MMMM d, yyyy")</span>
                        </div>

                        <div class="metadata-item">
                            <span class="metadata-label">Rating</span>
                            <div class="movie-rating">
                                <i class="fas fa-star"></i>
                                @Model.Rating.ToString("0.0")
                            </div>
                        </div>
                    </div>

                    @if (Model.MovieGenres != null && Model.MovieGenres.Any())
                    {
                        <div class="genre-tags">
                            @foreach (var movieGenre in Model.MovieGenres)
                            {
                                <span class="genre-tag">@movieGenre.Genre.Name</span>
                            }
                        </div>
                    }

                    <div class="movie-description">
                        <p>@Model.Description</p>
                    </div>
                </div>
            </div>

            @if (Model.MovieActors != null && Model.MovieActors.Any())
            {
                <div class="cast-section">
                    <h2>Cast</h2>
                    <div class="cast-grid">
                        @foreach (var movieActor in Model.MovieActors)
                        {
                            <div class="cast-card">
                                @if (!string.IsNullOrEmpty(movieActor.Actor.PhotoUrl))
                                {
                                    <img src="@movieActor.Actor.PhotoUrl" class="cast-image" alt="@movieActor.Actor.Name">
                                }
                                <div class="cast-info">
                                    <h3 class="cast-name">@movieActor.Actor.Name</h3>
                                    <a asp-action="Details" asp-controller="Actor"
                                       asp-route-id="@movieActor.Actor.ActorId"
                                       asp-route-movieId="@Model.MovieId"
                                       class="btn-details">View Profile</a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.TrailerUrl))
            {
                <div class="trailer-section">
                    <h2>Trailer</h2>
                    <div class="ratio ratio-16x9">
                        <iframe src="@GetEmbedUrl(Model.TrailerUrl)"
                                title="Movie Trailer"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                allowfullscreen>
                        </iframe>
                    </div>
                </div>
            }

            <div class="sessions-section">
                <h2>Available Sessions</h2>
                @if (Model.Sessions != null && Model.Sessions.Any())
                {
                    var futureSessions = Model.Sessions
                    .Where(s => s.StartTime > DateTime.Now)
                    .OrderBy(s => s.StartTime)
                    .ToList();

                    // Filter sessions: keep only those with an active hall and not fully sold out
                    var availableSessions = futureSessions
                    .Where(s => s.Hall != null &&
                    s.Hall.IsActive &&
                    (s.Tickets == null || s.Tickets.Count < s.Hall.Capacity))
                    .ToList();

                    if (futureSessions.Any())
                    {
                        if (availableSessions.Any())
                        {
                            // Display the list of available sessions
                            <table class="sessions-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Time</th>
                                        <th>Hall</th>
                                        <th>Price</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var session in futureSessions)
                                    {
                                        <tr>
                                            <td>@session.StartTime.ToString("MMM dd, yyyy")</td>
                                            <td>@session.StartTime.ToString("HH:mm")</td>
                                            <td>@(session.Hall?.Name ?? "N/A")</td>
                                            <td>@session.Price.ToString("C")</td>
                                            <td>
                                                <a asp-controller="Ticket"
                                                   asp-action="Book"
                                                   asp-route-sessionId="@session.SessionId"
                                                   class="btn-details">Book Now</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p>No available sessions.</p>
                        }
                    }
                    else
                    {
                        <p>No future sessions available.</p>
                    }
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> No sessions scheduled for this movie.
                    </div>
                }
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Movies
            </a>
        </div>
    </div>
</div>
