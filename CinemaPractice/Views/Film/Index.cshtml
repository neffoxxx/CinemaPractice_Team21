@model IEnumerable<Infrastructure.Entities.Movie>

<h2 class="text-center my-4">Films</h2>
<div class="films-grid">
    @foreach (var movie in Model)
    {
        <div class="card">
            @if (!string.IsNullOrEmpty(movie.PosterUrl))
            {
                <img src="@movie.PosterUrl" class="card-img-top" alt="@movie.Title">
            }
            else
            {
                <img src="/images/default-movie-poster.jpg" class="card-img-top" alt="Default poster">
            }
            <div class="card-body">
                <h5 class="card-title">@movie.Title</h5>
                <div class="rating-badge">
                    <i class="fas fa-star"></i>
                    @movie.Rating.ToString("0.0")
                </div>
                @if (movie.MovieGenres != null && movie.MovieGenres.Any())
                {
                    <div class="genre-tags">
                        @foreach (var movieGenre in movie.MovieGenres)
                        {
                            <span class="genre-tag">@movieGenre.Genre.Name</span>
                        }
                    </div>
                }
                <a href="@Url.Action("Details", "Film", new { id = movie.MovieId })"
                   class="btn btn-details">View Details</a>
        </div>
    </div>
    }
</div>

@section Styles {
    <style>
        .card {
            transition: transform 0.2s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            max-width: 300px;
            margin: 0 auto;
            /*Add relative position here for better click area*/
            position: relative;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: 0 6px 12px rgba(0,0,0,0.15);
            }

        .card-title {
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .card-img-top {
            object-position: center top;
        }
    </style>
}

