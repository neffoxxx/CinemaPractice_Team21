@model IEnumerable<GenreDTO>

<h2>Manage Genres</h2>
<p>
    <a asp-action="AddGenre" class="btn btn-primary">Add New Genre</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var genre in Model)
        {
            <tr>
                <td>@genre.Name</td>
                <td>
                    <a asp-action="EditGenre" asp-route-id="@genre.GenreId"
                       class="btn btn-sm text-primary hover:bg-primary-50 rounded-lg p-2">
                        <i class="fas fa-edit"></i>
                    </a>
                    <form asp-action="DeleteGenre" asp-route-id="@genre.GenreId"
                          method="post"
                          class="d-inline-block manage-films-delete-btn"
                          onsubmit="return confirm('Are you sure you want to delete this genre?');">
                        <button type="submit"
                                class="btn btn-sm text-danger hover:bg-danger-50 rounded-lg p-2">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table> 