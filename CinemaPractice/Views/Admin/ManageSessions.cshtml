@model IEnumerable<AppCore.DTOs.SessionDTO>
<h2>Manage Sessions</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<p>
    <a asp-action="AddSession" class="btn btn-primary">Add New Session</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Movie</th>
            <th>Hall</th>
            <th>Start Time</th>
            <th>End Time</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MovieTitle</td>
                    <td>@item.HallName</td>
                    <td>@item.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.EndTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>
                        <div class="d-flex justify-content-center gap-2">
                            <a asp-action="EditSession" asp-route-id="@item.SessionId"
                               class="btn btn-sm text-primary hover:bg-primary-50 rounded-lg p-2">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form asp-action="DeleteSession" asp-route-id="@item.SessionId" method="post"
                                  class="d-inline-block manage-films-delete-btn"
                                  onsubmit="return confirm('Are you sure you want to delete this session?');">
                                <button type="submit"
                                        class="btn btn-sm text-danger hover:bg-danger-50 rounded-lg p-2">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">No sessions found</td>
            </tr>
        }
    </tbody>
</table>